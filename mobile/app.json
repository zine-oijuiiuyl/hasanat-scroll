{
  "expo": {
    "name": "Hasanat Scroll",
    "slug": "hasanat-scroll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#061a18",
    "splash": {
      "backgroundColor": "#061a18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hasanatscroll.mobile"
    },
    "android": {
      "package": "app.hasanatscroll.mobile"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-sharing",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used once to work out prayer times where you are. Your location stays on your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f5b83d"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "449bdd6c-4533-4805-831c-31159366ac5b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/449bdd6c-4533-4805-831c-31159366ac5b"
    }
  }
}

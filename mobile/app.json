{
  "expo": {
    "name": "Hasanat Scroll",
    "slug": "hasanat-scroll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#061a18",
    "splash": {
      "backgroundColor": "#061a18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hasanatscroll.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hasanatscroll.mobile",
      "versionCode": 2,
      "runtimeVersion": "1.1.0",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used once to work out prayer times where you are. Your location stays on your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f5b83d",
          "sounds": [
            "./assets/adhan/adhan_makkah.mp3",
            "./assets/adhan/adhan_madinah.mp3",
            "./assets/adhan/adhan_melodic.mp3"
          ]
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "449bdd6c-4533-4805-831c-31159366ac5b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/449bdd6c-4533-4805-831c-31159366ac5b"
    },
    "experiments": {
      "baseUrl": "/hasanat-scroll"
    },
    "web": {
      "name": "Hasanat Scroll",
      "shortName": "Hasanat",
      "backgroundColor": "#061a18",
      "themeColor": "#061a18",
      "favicon": "./assets/icon.png"
    }
  }
}
